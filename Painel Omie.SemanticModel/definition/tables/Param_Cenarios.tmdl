	column ordem
		dataType: int64
		lineageTag: b6407af7-50e7-4877-a4d9-d1e54e0c75c3
		summarizeBy: none
		sourceColumn: ordem

		annotation SummarizationSetBy = User

	column cenario
		dataType: string
		lineageTag: ecfdb580-b52b-4e0b-aebd-18de3daf672b
		summarizeBy: none
		sourceColumn: cenario
		sortByColumn: ordem

		annotation SummarizationSetBy = User

	column pct_redirecionado
		dataType: double
		lineageTag: 6b10fb61-8214-4f9c-9312-113526fd4434
