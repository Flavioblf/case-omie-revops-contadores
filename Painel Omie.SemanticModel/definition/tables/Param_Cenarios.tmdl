	partition Param_Cenarios = m
		mode: import
		source =
				let
				    Fonte = #table(
				        type table [ordem = Int64.Type, cenario = text, pct_redirecionado = number, fator_realizacao = number],
				        {{1, "Conservador", 0.3, 0.25}, {2, "Base", 0.5, 0.4}, {3, "Otimista", 0.6, 0.6}})
				in
				    Fonte

	annotation PBI_ResultType = Table
