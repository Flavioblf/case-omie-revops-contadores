/// Premissas dos cenários de impacto (iguais à aba Impacto_nMRR do Excel)
table Param_Cenarios
	lineageTag: 936b157f-7dcd-4eb4-9dc8-ad003d9d2ef3

	column ordem
		dataType: int64
		lineageTag: 6ced9e7e-f562-4cd2-9c8b-a276f4499763
		summarizeBy: none
		sourceColumn: ordem

		annotation SummarizationSetBy = User

	column cenario
		dataType: string
		lineageTag: 9c4e4a1d-7f62-4db7-88d7-4f707dcc06ea
		summarizeBy: none
		sourceColumn: cenario
		sortByColumn: ordem

		annotation SummarizationSetBy = User

	column pct_redirecionado
		dataType: double
		lineageTag: c5ffdbfc-16a4-4514-a124-9e9a002ee8c1
		summarizeBy: none
		sourceColumn: pct_redirecionado

		annotation SummarizationSetBy = User

	column fator_realizacao
		dataType: double
		lineageTag: 5ce2efc5-062f-4b9d-85bd-ecaf0bbed280
