/// Franquias: meta e realizado de nMRR (impacto e Desafio 3).
table franquias
	lineageTag: fe5a4246-d4c7-48d3-8ede-6823ed7ed379

	column id_franquia
		dataType: string
		lineageTag: 691f2fe9-4146-41ce-8ef7-ed30b66f6adf
		summarizeBy: none
		sourceColumn: id_franquia

		annotation SummarizationSetBy = User

	column nome_franquia
		dataType: string
		lineageTag: d647311a-ed04-4dc4-a70a-d9a6afc93ff0
		summarizeBy: none
		sourceColumn: nome_franquia

		annotation SummarizationSetBy = User

	column estado
		dataType: string
		lineageTag: f67c90c2-5e13-4cab-803c-790a6f4f69e5
		summarizeBy: none
		sourceColumn: estado

		annotation SummarizationSetBy = User

	column regiao
		dataType: string
		lineageTag: c35bc788-564c-4158-adf6-5355b6e2e96f
		summarizeBy: none
		sourceColumn: regiao

		annotation SummarizationSetBy = User

	column meses_operando
		dataType: int64
		lineageTag: e94b7fae-e682-4bb0-92f3-cad45db4c0f2
		summarizeBy: none
		sourceColumn: meses_operando

		annotation SummarizationSetBy = User

	column meta_nmrr_mes
		dataType: int64
		lineageTag: 08853bf7-984a-4308-a1b7-8cf18df03569
		summarizeBy: none
		sourceColumn: meta_nmrr_mes

		annotation SummarizationSetBy = User

	column realizado_nmrr_mes
		dataType: int64
		lineageTag: 630e01d8-39b0-4e9c-8b05-60ca547d61e5
		summarizeBy: none
		sourceColumn: realizado_nmrr_mes

		annotation SummarizationSetBy = User

	column num_executivos
		dataType: int64
		lineageTag: 5e992097-386d-49b3-bbb1-73c8effaaec8
		summarizeBy: none
		sourceColumn: num_executivos

		annotation SummarizationSetBy = User

	column atingimento_pct
		dataType: double
		lineageTag: 2fab6014-ef7f-45a0-b859-62bab9d1aa9e
		summarizeBy: none
		sourceColumn: atingimento_pct

		annotation SummarizationSetBy = User

	column data_inicio
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 791c8763-f46b-404b-b550-8a181ae5cd03
		summarizeBy: none
		sourceColumn: data_inicio

		annotation SummarizationSetBy = User

	/// Realizado ÷ meta de nMRR
	column atingimento =
			DIVIDE(franquias[realizado_nmrr_mes], franquias[meta_nmrr_mes])
		dataType: double
		formatString: 0%
		lineageTag: df7db326-6129-4e18-8fd0-560e38513457
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Meta − realizado (R$/mês), zero para quem bateu a meta
	column gap =
			MAX(0, franquias[meta_nmrr_mes] - franquias[realizado_nmrr_mes])
		dataType: double
		formatString: #,0
		lineageTag: 58bcec8d-71b9-4542-b7a3-05efda7fec2c
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Realizado de nMRR por EC
	column realizado_por_ec =
			DIVIDE(franquias[realizado_nmrr_mes], franquias[num_executivos])
		dataType: double
		formatString: #,0
		lineageTag: c4c0ae35-f84d-4992-a1e0-def021ad4836
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Na meta ou abaixo da meta
	column situacao =
			IF(franquias[atingimento] >= 1, "Na meta", "Abaixo da meta")
		dataType: string
		lineageTag: 2bd163e8-497b-4b57-9add-fc67145e2f70
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Ordem do menor para o maior atingimento (desempate pelo id)
	column ordem_atingimento =
			RANKX(ALLNOBLANKROW(franquias), franquias[atingimento] + VALUE(RIGHT(franquias[id_franquia], 3)) / 1000000, , ASC, DENSE)
		dataType: int64
		formatString: 0
		lineageTag: d2bcdb45-dc9e-4951-8621-b7f331e6e6eb
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	/// Franquia, meses de operação e atingimento, ordenada pelo atingimento
	column rotulo =
			SUBSTITUTE(franquias[nome_franquia], "Franquia ", "") & " · " & franquias[meses_operando] & "m · " & FORMAT(franquias[atingimento], "0%")
		dataType: string
		lineageTag: aff4b226-df8a-433a-9457-8b550187fe4e
		summarizeBy: none
		sortByColumn: ordem_atingimento

		annotation SummarizationSetBy = User

	partition franquias = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSQL, BancoSQL),
				    Dados = Fonte{[Schema="raw", Item="franquias"]}[Data],
				    SemLinhaOrigem = Table.RemoveColumns(Dados, {"linha_origem"})
				in
				    SemLinhaOrigem

	annotation PBI_ResultType = Table
