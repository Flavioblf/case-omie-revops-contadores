/// Franquias: meta e realizado de nMRR (impacto e Desafio 3).
table franquias
	lineageTag: f3a37533-410b-448c-a7c4-54cf6ffba337

	column id_franquia
		dataType: string
		lineageTag: 0f74db75-c528-414a-9f40-912064a4a6fb
		summarizeBy: none
		sourceColumn: id_franquia

		annotation SummarizationSetBy = User

	column nome_franquia
		dataType: string
		lineageTag: 69a8d641-24bc-417d-8490-da563e8e3d67
		summarizeBy: none
		sourceColumn: nome_franquia

		annotation SummarizationSetBy = User

	column estado
		dataType: string
		lineageTag: fd2fda30-0494-45a1-a2f3-3be7ac550daf
		summarizeBy: none
		sourceColumn: estado

		annotation SummarizationSetBy = User

	column regiao
		dataType: string
		lineageTag: 6fd90a7c-3bf8-4226-9b18-35650d6fad51
		summarizeBy: none
		sourceColumn: regiao

		annotation SummarizationSetBy = User

	column meses_operando
		dataType: int64
		lineageTag: eb59df6e-8290-4e05-a11a-cd7df3cce657
		summarizeBy: none
		sourceColumn: meses_operando

		annotation SummarizationSetBy = User

	column meta_nmrr_mes
		dataType: int64
		lineageTag: 687a738f-7732-4349-8bc4-7532c015a937
		summarizeBy: none
		sourceColumn: meta_nmrr_mes

		annotation SummarizationSetBy = User

	column realizado_nmrr_mes
		dataType: int64
		lineageTag: 20484bfe-5b16-4706-b27a-712d6f9cc4e3
		summarizeBy: none
		sourceColumn: realizado_nmrr_mes

		annotation SummarizationSetBy = User

	column num_executivos
		dataType: int64
		lineageTag: 366aa0db-956f-4282-a13a-e92bafff4620
		summarizeBy: none
		sourceColumn: num_executivos

		annotation SummarizationSetBy = User

	column atingimento_pct
		dataType: double
		lineageTag: 869781a6-7ffe-431c-bc23-83b66164ceac
		summarizeBy: none
		sourceColumn: atingimento_pct

		annotation SummarizationSetBy = User

	column data_inicio
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 5edc56c8-ad89-4abb-ba9e-82a3d8c498d7
		summarizeBy: none
		sourceColumn: data_inicio

		annotation SummarizationSetBy = User

	/// Realizado ÷ meta de nMRR
	column atingimento =
			DIVIDE(franquias[realizado_nmrr_mes], franquias[meta_nmrr_mes])
		dataType: double
		formatString: 0%
		lineageTag: 3956dcba-44fd-4aaf-b336-7b1a959596d4
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Meta − realizado (R$/mês), zero para quem bateu a meta
	column gap =
			MAX(0, franquias[meta_nmrr_mes] - franquias[realizado_nmrr_mes])
		dataType: double
		formatString: #,0
		lineageTag: 64a3be0a-59e2-4620-8fb5-51a6171e0d56
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Realizado de nMRR por EC
	column realizado_por_ec =
			DIVIDE(franquias[realizado_nmrr_mes], franquias[num_executivos])
		dataType: double
		formatString: #,0
		lineageTag: 31c439ef-1209-40a3-8198-21cc9a0c6741
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Na meta ou abaixo da meta
	column situacao =
			IF(franquias[atingimento] >= 1, "Na meta", "Abaixo da meta")
		dataType: string
		lineageTag: 1683eb47-ec6b-45a7-8283-9dad24debcbd
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Ordem do menor para o maior atingimento (desempate pelo id)
	column ordem_atingimento =
			RANKX(ALLNOBLANKROW(franquias), franquias[atingimento] + VALUE(RIGHT(franquias[id_franquia], 3)) / 1000000, , ASC, DENSE)
		dataType: int64
		formatString: 0
		lineageTag: 0156f898-5a28-4580-bf2b-7884d45dcbe6
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	/// Franquia, meses de operação e atingimento, ordenada pelo atingimento
	column rotulo =
			SUBSTITUTE(franquias[nome_franquia], "Franquia ", "") & " · " & franquias[meses_operando] & "m · " & FORMAT(franquias[atingimento], "0%")
		dataType: string
		lineageTag: 9ed5df8d-e5c6-4118-a5cc-e4a5c697778e
		summarizeBy: none
		sortByColumn: ordem_atingimento

		annotation SummarizationSetBy = User

	partition franquias = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSQL, BancoSQL),
				    Dados = Fonte{[Schema="raw", Item="franquias"]}[Data],
				    SemLinhaOrigem = Table.RemoveColumns(Dados, {"linha_origem"})
				in
				    SemLinhaOrigem

	annotation PBI_ResultType = Table
