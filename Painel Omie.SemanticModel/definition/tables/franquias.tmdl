/// Franquias: meta e realizado de nMRR (impacto e Desafio 3).
table franquias
	lineageTag: bf5848ed-2f5d-452b-afe7-04e7f44cefd8

	column id_franquia
		dataType: string
		lineageTag: 5058b297-5298-4b62-8a5f-4871eccf9ed6
		summarizeBy: none
		sourceColumn: id_franquia

		annotation SummarizationSetBy = User

	column nome_franquia
		dataType: string
		lineageTag: 17a93de7-23f3-41ff-8f46-2e6cf1a69498
		summarizeBy: none
		sourceColumn: nome_franquia

		annotation SummarizationSetBy = User

	column estado
		dataType: string
		lineageTag: dbd9889c-e7dc-486c-9658-cfed71179a04
		summarizeBy: none
		sourceColumn: estado

		annotation SummarizationSetBy = User

	column regiao
		dataType: string
		lineageTag: 78782505-e7fe-4656-a8f8-0079533483b6
		summarizeBy: none
		sourceColumn: regiao

		annotation SummarizationSetBy = User

	column meses_operando
		dataType: int64
		lineageTag: 6dbe6514-a703-4d4d-8454-46bd144b965b
		summarizeBy: none
		sourceColumn: meses_operando

		annotation SummarizationSetBy = User

	column meta_nmrr_mes
		dataType: int64
		lineageTag: d361c47c-e11a-4a60-a1b2-542b6f8a6e8b
		summarizeBy: none
		sourceColumn: meta_nmrr_mes

		annotation SummarizationSetBy = User

	column realizado_nmrr_mes
		dataType: int64
		lineageTag: 9e517c50-0f2b-4af6-ba0c-047ced9678e5
		summarizeBy: none
		sourceColumn: realizado_nmrr_mes

		annotation SummarizationSetBy = User

	column num_executivos
		dataType: int64
		lineageTag: 4178a7d7-a10f-4eea-877d-515788c2a47a
		summarizeBy: none
		sourceColumn: num_executivos

		annotation SummarizationSetBy = User

	column atingimento_pct
		dataType: double
		lineageTag: 585b8320-3bb9-4f0f-8373-ea79fa5f1b71
		summarizeBy: none
		sourceColumn: atingimento_pct

		annotation SummarizationSetBy = User

	column data_inicio
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: c0609061-35ca-49da-8e16-217a2de1738f
		summarizeBy: none
		sourceColumn: data_inicio

		annotation SummarizationSetBy = User

	/// Realizado ÷ meta de nMRR
	column atingimento =
			DIVIDE(franquias[realizado_nmrr_mes], franquias[meta_nmrr_mes])
		dataType: double
		formatString: 0%
		lineageTag: 890e7954-528e-4cad-90a6-4a74e69c0d6b
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Meta − realizado (R$/mês), zero para quem bateu a meta
	column gap =
			MAX(0, franquias[meta_nmrr_mes] - franquias[realizado_nmrr_mes])
		dataType: double
		formatString: #,0
		lineageTag: d6b52d0c-293c-4f4c-8d78-01d26ab34763
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Realizado de nMRR por EC
	column realizado_por_ec =
			DIVIDE(franquias[realizado_nmrr_mes], franquias[num_executivos])
		dataType: double
		formatString: #,0
		lineageTag: 83196a0c-7763-4906-9e01-dc35a5b957e8
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Na meta ou abaixo da meta
	column situacao =
			IF(franquias[atingimento] >= 1, "Na meta", "Abaixo da meta")
		dataType: string
		lineageTag: 50f90704-48e7-4b28-9315-918f9c8bbea4
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Ordem do menor para o maior atingimento (desempate pelo id)
	column ordem_atingimento =
			RANKX(ALLNOBLANKROW(franquias), franquias[atingimento] + VALUE(RIGHT(franquias[id_franquia], 3)) / 1000000, , ASC, DENSE)
		dataType: int64
		formatString: 0
		lineageTag: 26035849-0b87-4a4a-8896-92d0222ce859
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	/// Franquia, nº de ECs e atingimento, ordenada pelo atingimento
	column rotulo =
			SUBSTITUTE(franquias[nome_franquia], "Franquia ", "") & " · " & franquias[num_executivos] & " EC · " & FORMAT(franquias[atingimento], "0%")
		dataType: string
		lineageTag: 5dfc91b4-3a1b-48ca-a77a-4f6f26ddb836
		summarizeBy: none
		sortByColumn: ordem_atingimento

		annotation SummarizationSetBy = User

	partition franquias = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSQL, BancoSQL),
				    Dados = Fonte{[Schema="raw", Item="franquias"]}[Data],
				    SemLinhaOrigem = Table.RemoveColumns(Dados, {"linha_origem"})
				in
				    SemLinhaOrigem

	annotation PBI_ResultType = Table
