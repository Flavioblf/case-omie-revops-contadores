/// Franquias: meta e realizado de nMRR (impacto e Desafio 3).
table franquias
	lineageTag: 1585b3bb-a884-4741-a4f6-b0def8376eec

	column id_franquia
		dataType: string
		lineageTag: b524ab02-e409-40cd-ac67-e80d1a31828a
		summarizeBy: none
		sourceColumn: id_franquia

		annotation SummarizationSetBy = User

	column nome_franquia
		dataType: string
		lineageTag: 5a2805cf-6645-47f7-903f-820625cfe2fe
		summarizeBy: none
		sourceColumn: nome_franquia

		annotation SummarizationSetBy = User

	column estado
		dataType: string
		lineageTag: 6c021bf4-cad6-477d-a1ee-5e9415762aeb
		summarizeBy: none
		sourceColumn: estado

		annotation SummarizationSetBy = User

	column regiao
		dataType: string
		lineageTag: 73088050-1116-425d-a613-77ee36712d0f
		summarizeBy: none
		sourceColumn: regiao

		annotation SummarizationSetBy = User

	column meses_operando
		dataType: int64
		lineageTag: ab4164ce-26e7-4750-be19-47e238bff237
		summarizeBy: none
		sourceColumn: meses_operando

		annotation SummarizationSetBy = User

	column meta_nmrr_mes
		dataType: int64
		lineageTag: 011abd72-7a8a-42f2-9245-ef815c0a458b
		summarizeBy: none
		sourceColumn: meta_nmrr_mes

		annotation SummarizationSetBy = User

	column realizado_nmrr_mes
		dataType: int64
		lineageTag: 9c935bd0-3931-4125-8d1f-7621f3a9fcee
		summarizeBy: none
		sourceColumn: realizado_nmrr_mes

		annotation SummarizationSetBy = User

	column num_executivos
		dataType: int64
		lineageTag: 10a27806-399a-4ffb-a9f9-cea5b06af9ef
		summarizeBy: none
		sourceColumn: num_executivos

		annotation SummarizationSetBy = User

	column atingimento_pct
		dataType: double
		lineageTag: b90407d4-0f33-47ea-b3df-8e2ea477d179
		summarizeBy: none
		sourceColumn: atingimento_pct

		annotation SummarizationSetBy = User

	column data_inicio
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: f3e20040-54d9-487a-8147-e0984c8218e5
		summarizeBy: none
		sourceColumn: data_inicio

		annotation SummarizationSetBy = User

	/// Realizado ÷ meta de nMRR
	column atingimento =
			DIVIDE(franquias[realizado_nmrr_mes], franquias[meta_nmrr_mes])
		dataType: double
		formatString: 0%
		lineageTag: 17d28986-9140-4208-b4bf-6de9f3b5bd3c
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Meta − realizado (R$/mês), zero para quem bateu a meta
	column gap =
			MAX(0, franquias[meta_nmrr_mes] - franquias[realizado_nmrr_mes])
		dataType: double
		formatString: #,0
		lineageTag: 8898b1a3-8709-4ad5-abb2-09b4e207c0b0
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Realizado de nMRR por EC
	column realizado_por_ec =
			DIVIDE(franquias[realizado_nmrr_mes], franquias[num_executivos])
		dataType: double
		formatString: #,0
		lineageTag: ab51f7c9-02fa-47bb-95db-3559fdb92dd9
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Na meta ou abaixo da meta
	column situacao =
			IF(franquias[atingimento] >= 1, "Na meta", "Abaixo da meta")
		dataType: string
		lineageTag: 0f0c3bf5-0e2f-475f-bad8-a3c1f5454e20
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Ordem do menor para o maior atingimento (desempate pelo id)
	column ordem_atingimento =
			RANKX(ALLNOBLANKROW(franquias), franquias[atingimento] + VALUE(RIGHT(franquias[id_franquia], 3)) / 1000000, , ASC, DENSE)
		dataType: int64
		formatString: 0
		lineageTag: 9bea0d07-e894-4380-9808-242615903c16
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	/// Franquia, nº de ECs e atingimento, ordenada pelo atingimento
	column rotulo =
			SUBSTITUTE(franquias[nome_franquia], "Franquia ", "") & " · " & franquias[num_executivos] & " EC · " & FORMAT(franquias[atingimento], "0%")
		dataType: string
		lineageTag: 6f5ba15b-8b07-4e2d-bb08-df69ccce8432
		summarizeBy: none
		sortByColumn: ordem_atingimento

		annotation SummarizationSetBy = User

	partition franquias = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSQL, BancoSQL),
				    Dados = Fonte{[Schema="raw", Item="franquias"]}[Data],
				    SemLinhaOrigem = Table.RemoveColumns(Dados, {"linha_origem"})
				in
				    SemLinhaOrigem

	annotation PBI_ResultType = Table
