/// Franquias: meta e realizado de nMRR (impacto e Desafio 3).
table franquias
	lineageTag: 6f3b0df6-6dbb-4e17-b8d1-736cb9e2493d

	column id_franquia
		dataType: string
		lineageTag: 35554e97-3b00-4f7d-885d-e1fba0e32aeb
		summarizeBy: none
		sourceColumn: id_franquia

		annotation SummarizationSetBy = User

	column nome_franquia
		dataType: string
		lineageTag: eb7716a9-659d-41c3-9dec-ba541390ff58
		summarizeBy: none
		sourceColumn: nome_franquia

		annotation SummarizationSetBy = User

	column estado
		dataType: string
		lineageTag: 47a4634b-c874-46ca-8c9d-e6b42bacf44f
		summarizeBy: none
		sourceColumn: estado

		annotation SummarizationSetBy = User

	column regiao
		dataType: string
		lineageTag: a4545a6b-9fd2-46bd-99dc-b0e0c6d335e8
		summarizeBy: none
		sourceColumn: regiao

		annotation SummarizationSetBy = User

	column meses_operando
		dataType: int64
		lineageTag: c8f38b54-290f-4ed4-b829-b86904bc845d
		summarizeBy: none
		sourceColumn: meses_operando

		annotation SummarizationSetBy = User

	column meta_nmrr_mes
		dataType: int64
		lineageTag: c089c073-6122-4695-8d95-545946900e3c
		summarizeBy: none
		sourceColumn: meta_nmrr_mes

		annotation SummarizationSetBy = User

	column realizado_nmrr_mes
		dataType: int64
		lineageTag: 1611c51a-74ad-44bb-902c-9c8b50aedd26
		summarizeBy: none
		sourceColumn: realizado_nmrr_mes

		annotation SummarizationSetBy = User

	column num_executivos
		dataType: int64
		lineageTag: 6d7d6c9c-9fc5-481d-a212-bc07a76f953d
		summarizeBy: none
		sourceColumn: num_executivos

		annotation SummarizationSetBy = User

	column atingimento_pct
		dataType: double
		lineageTag: 64793fc5-27dd-414f-af2d-747721d8c3cf
		summarizeBy: none
		sourceColumn: atingimento_pct

		annotation SummarizationSetBy = User

	column data_inicio
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: f54806a0-f025-45ec-b1c9-2a55d9a93917
		summarizeBy: none
		sourceColumn: data_inicio

		annotation SummarizationSetBy = User

	/// Realizado ÷ meta de nMRR
	column atingimento =
			DIVIDE(franquias[realizado_nmrr_mes], franquias[meta_nmrr_mes])
		dataType: double
		formatString: 0%
		lineageTag: a3f515d0-69fa-46a6-be53-c818ca7ec25c
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Meta − realizado (R$/mês), zero para quem bateu a meta
	column gap =
			MAX(0, franquias[meta_nmrr_mes] - franquias[realizado_nmrr_mes])
		dataType: double
		formatString: #,0
		lineageTag: b5f0c5ef-d122-4d8d-88f9-da7e3c443a36
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Realizado de nMRR por EC
	column realizado_por_ec =
			DIVIDE(franquias[realizado_nmrr_mes], franquias[num_executivos])
		dataType: double
		formatString: #,0
		lineageTag: 90babe67-af98-4b5c-843d-1d153b41e15b
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Na meta ou abaixo da meta
	column situacao =
			IF(franquias[atingimento] >= 1, "Na meta", "Abaixo da meta")
		dataType: string
		lineageTag: 4a118d9d-2446-45be-89ef-15df4fda9718
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Ordem do menor para o maior atingimento (desempate pelo id)
	column ordem_atingimento =
			RANKX(ALLNOBLANKROW(franquias), franquias[atingimento] + VALUE(RIGHT(franquias[id_franquia], 3)) / 1000000, , ASC, DENSE)
		dataType: int64
		formatString: 0
		lineageTag: 7c073608-5be5-4576-9d49-d378a0e4fc33
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	/// Franquia, nº de ECs e atingimento, ordenada pelo atingimento
	column rotulo =
			SUBSTITUTE(franquias[nome_franquia], "Franquia ", "") & " · " & franquias[num_executivos] & " EC · " & FORMAT(franquias[atingimento], "0%")
		dataType: string
		lineageTag: 6c87124b-e575-4c69-aeb7-b4e5d2ddd676
		summarizeBy: none
		sortByColumn: ordem_atingimento

		annotation SummarizationSetBy = User

	partition franquias = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSQL, BancoSQL),
				    Dados = Fonte{[Schema="raw", Item="franquias"]}[Data],
				    SemLinhaOrigem = Table.RemoveColumns(Dados, {"linha_origem"})
				in
				    SemLinhaOrigem

	annotation PBI_ResultType = Table
