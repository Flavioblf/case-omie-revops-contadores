/// Franquias: meta e realizado de nMRR (impacto e Desafio 3).
table franquias
	lineageTag: b2e5c89e-f99d-45ef-a934-e992ec906901

	column id_franquia
		dataType: string
		lineageTag: 7a06423b-c34d-4906-b298-0f06c91d8fd0
		summarizeBy: none
		sourceColumn: id_franquia

		annotation SummarizationSetBy = User

	column nome_franquia
		dataType: string
		lineageTag: 098875c7-4817-4a1e-bbfa-8cce93b42130
		summarizeBy: none
		sourceColumn: nome_franquia

		annotation SummarizationSetBy = User

	column estado
		dataType: string
		lineageTag: 06df2b17-2359-46e2-8d89-dfdbdd94c8f9
		summarizeBy: none
		sourceColumn: estado

		annotation SummarizationSetBy = User

	column regiao
		dataType: string
		lineageTag: fc9147c6-d917-4cb7-bbe4-c3d6bc0b945f
		summarizeBy: none
		sourceColumn: regiao

		annotation SummarizationSetBy = User

	column meses_operando
		dataType: int64
		lineageTag: 22b628ae-0a72-40e6-be83-a3d9f1b37b75
		summarizeBy: none
		sourceColumn: meses_operando

		annotation SummarizationSetBy = User

	column meta_nmrr_mes
		dataType: int64
		lineageTag: 0727ad7d-bb46-49d0-a92b-0f92f8a0a8f1
		summarizeBy: none
		sourceColumn: meta_nmrr_mes

		annotation SummarizationSetBy = User

	column realizado_nmrr_mes
		dataType: int64
		lineageTag: c2ebae3e-468a-4598-a84a-a05ce247e1ae
		summarizeBy: none
		sourceColumn: realizado_nmrr_mes

		annotation SummarizationSetBy = User

	column num_executivos
		dataType: int64
		lineageTag: 76fa739c-d151-43e0-9577-fbcd2947df50
		summarizeBy: none
		sourceColumn: num_executivos

		annotation SummarizationSetBy = User

	column atingimento_pct
		dataType: double
		lineageTag: 579c5edc-ee04-4586-9746-5f4f58003448
		summarizeBy: none
		sourceColumn: atingimento_pct

		annotation SummarizationSetBy = User

	column data_inicio
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 8b307f7d-523f-4f46-8527-59a86d67cc90
		summarizeBy: none
		sourceColumn: data_inicio

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	/// Realizado ÷ meta de nMRR
	column atingimento = DIVIDE(franquias[realizado_nmrr_mes], franquias[meta_nmrr_mes])
		dataType: double
		formatString: 0%
		lineageTag: eb47db02-afbf-4d37-bf27-7bfd2785de1c
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Meta − realizado (R$/mês), zero para quem bateu a meta
	column gap = MAX(0, franquias[meta_nmrr_mes] - franquias[realizado_nmrr_mes])
		dataType: double
		formatString: #,0
		lineageTag: 5fae7140-5777-4681-b520-03616e3afd79
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Realizado de nMRR por EC
	column realizado_por_ec = DIVIDE(franquias[realizado_nmrr_mes], franquias[num_executivos])
		dataType: double
		formatString: #,0
		lineageTag: 1d91d491-eb61-48bc-80c4-2821dae513e8
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Ordem do menor para o maior atingimento (desempate pelo id)
	column ordem_atingimento = RANKX(ALLNOBLANKROW(franquias), franquias[atingimento] + VALUE(RIGHT(franquias[id_franquia], 3)) / 1000000, , ASC, DENSE)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0f63a25a-4dac-4530-9d8a-824a46895d6e
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Franquia, nº de ECs e atingimento, ordenada pelo atingimento
	column rotulo = SUBSTITUTE(franquias[nome_franquia], "Franquia ", "") & " · " & franquias[num_executivos] & " EC · " & FORMAT(franquias[atingimento], "0%")
		dataType: string
		lineageTag: 6b215c91-c642-45a0-8b4f-09209d81e3e5
		summarizeBy: none
		sortByColumn: ordem_atingimento

		annotation SummarizationSetBy = User

	/// Na meta ou abaixo da meta
	column situacao = IF(franquias[atingimento] >= 1, "Na meta", "Abaixo da meta")
		dataType: string
		lineageTag: 089a66a3-f7d9-4ad2-898f-b21b47c3d385
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition franquias = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSQL, BancoSQL),
				    Dados = Fonte{[Schema="raw", Item="franquias"]}[Data],
				    SemLinhaOrigem = Table.RemoveColumns(Dados, {"linha_origem"})
				in
				    SemLinhaOrigem

	annotation PBI_ResultType = Table

