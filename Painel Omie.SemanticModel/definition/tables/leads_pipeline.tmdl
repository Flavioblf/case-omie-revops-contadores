/// Pipeline comercial: resultado real (Ganho/Perdido) para contrastar com o target.
table leads_pipeline
	lineageTag: ceb1b4cf-ec13-4f40-9936-66bd627ce55c

	column id_lead
		dataType: string
		lineageTag: f118178b-3be9-4906-8897-794f523e2758
		summarizeBy: none
		sourceColumn: id_lead

		annotation SummarizationSetBy = User

	column id_contador
		dataType: string
		lineageTag: 75b58f11-995b-4264-898b-518ecdc8ca0f
		summarizeBy: none
		sourceColumn: id_contador

		annotation SummarizationSetBy = User

	column canal_origem
		dataType: string
		lineageTag: 5e8f05b7-27e6-41f6-9653-7bef8785f9fb
		summarizeBy: none
		sourceColumn: canal_origem

		annotation SummarizationSetBy = User

	column id_franquia
		dataType: string
		lineageTag: 2b771e10-984c-4b4e-bede-4b902acee9b9
		summarizeBy: none
		sourceColumn: id_franquia

		annotation SummarizationSetBy = User

	column data_entrada
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 36ab74d6-f357-4e34-8fab-c8c014a6a20f
		summarizeBy: none
		sourceColumn: data_entrada

		annotation SummarizationSetBy = User

	column status_lead
		dataType: string
		lineageTag: 27651400-516d-4c5d-8c05-3c43bbfdc8a9
		summarizeBy: none
		sourceColumn: status_lead

		annotation SummarizationSetBy = User

	column data_conversao
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 23b967fa-d5d8-41b0-914c-6be94168edff
		summarizeBy: none
		sourceColumn: data_conversao

		annotation SummarizationSetBy = User

	column mrr_inicial
		dataType: double
		lineageTag: 51bf903c-8607-4b34-affb-52058aa8e0e2
		summarizeBy: none
		sourceColumn: mrr_inicial

		annotation SummarizationSetBy = User

	column motivo_perda
		dataType: string
		lineageTag: b6c55824-7903-445b-bc4f-7465391d38ed
		summarizeBy: none
		sourceColumn: motivo_perda

		annotation SummarizationSetBy = User

	column num_tentativas_contato
		dataType: int64
		lineageTag: bae9f49e-31f6-4ef7-ac66-ee8c1c18e54c
		summarizeBy: none
		sourceColumn: num_tentativas_contato

		annotation SummarizationSetBy = User

	column tempo_ciclo_dias
		dataType: int64
		lineageTag: 2a5af624-53be-4672-8774-2518e863d61b
		summarizeBy: none
		sourceColumn: tempo_ciclo_dias

		annotation SummarizationSetBy = User

	/// 1 = lead Ganho
	column ganho =
			IF(leads_pipeline[status_lead] = "Ganho", 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: c0be8861-fff1-4084-a816-878d3c4fa7ba
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	/// Trimestre do Ganho (data_conversao)
	column trimestre_ganho =
			IF(leads_pipeline[status_lead] = "Ganho", FORMAT(YEAR(leads_pipeline[data_conversao]), "0") & " T" & FORMAT(QUARTER(leads_pipeline[data_conversao]), "0"))
		dataType: string
		lineageTag: d954877a-94b0-43dd-b6ab-ef3c1f62a4f9
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// 1 = lead encerrado (Ganho ou Perdido)
	column com_desfecho =
			IF(leads_pipeline[status_lead] IN {"Ganho", "Perdido"}, 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: f2b2e714-0d2a-41d9-ba4a-e57bca7d4692
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	partition leads_pipeline = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSQL, BancoSQL),
				    Dados = Fonte{[Schema="raw", Item="leads_pipeline"]}[Data],
				    SemLinhaOrigem = Table.RemoveColumns(Dados, {"linha_origem"})
				in
				    SemLinhaOrigem

	annotation PBI_ResultType = Table
