	column tempo_ciclo_dias
		dataType: int64
		lineageTag: 662cfc21-6dd5-41e7-9bf3-51654bdc8f23
		summarizeBy: none
		sourceColumn: tempo_ciclo_dias

		annotation SummarizationSetBy = User

	/// 1 = lead Ganho
	column ganho = IF(leads_pipeline[status_lead] = "Ganho", 1, 0)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f78b3302-d5c3-4b3d-8a20-2fafc5b62f60
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// 1 = lead encerrado (Ganho ou Perdido)
	column com_desfecho = IF(leads_pipeline[status_lead] IN {"Ganho", "Perdido"}, 1, 0)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8e1eeeb4-f5c8-4913-9e1b-59bdeec03eba
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition leads_pipeline = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSQL, BancoSQL),
				    Dados = Fonte{[Schema="raw", Item="leads_pipeline"]}[Data],
				    SemLinhaOrigem = Table.RemoveColumns(Dados, {"linha_origem"})
				in
				    SemLinhaOrigem

	annotation PBI_ResultType = Table

