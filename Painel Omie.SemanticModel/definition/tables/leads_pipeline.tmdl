/// Pipeline comercial: resultado real (Ganho/Perdido) para contrastar com o target.
table leads_pipeline
	lineageTag: 07ca64c7-a12f-4289-94e7-552e8ce4772a

	column id_lead
		dataType: string
		lineageTag: e8faed47-44b8-472c-bfd8-4c2b457cda21
		summarizeBy: none
		sourceColumn: id_lead

		annotation SummarizationSetBy = User

	column id_contador
		dataType: string
		lineageTag: c65eccb7-ebff-4e0c-a938-9f56c55c0926
		summarizeBy: none
		sourceColumn: id_contador

		annotation SummarizationSetBy = User

	column canal_origem
		dataType: string
		lineageTag: a4739489-c874-47a9-8077-b00d54a362cf
		summarizeBy: none
		sourceColumn: canal_origem

		annotation SummarizationSetBy = User

	column id_franquia
		dataType: string
		lineageTag: 1279d37f-5804-4fd7-818c-c4112f05fbe1
		summarizeBy: none
		sourceColumn: id_franquia

		annotation SummarizationSetBy = User

	column data_entrada
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: eaec4ccc-bb5f-4c49-901e-755eb69133f0
		summarizeBy: none
		sourceColumn: data_entrada

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column status_lead
		dataType: string
		lineageTag: 6f5224b4-b3d6-4f29-9878-3c716e289ea6
		summarizeBy: none
		sourceColumn: status_lead

		annotation SummarizationSetBy = User

	column data_conversao
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 66e43c02-8052-4e3b-b00e-73aecc32fdba
		summarizeBy: none
		sourceColumn: data_conversao

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column mrr_inicial
		dataType: double
		lineageTag: 06c235fd-8524-4a7b-a577-1f9ba414c3ec
		summarizeBy: none
		sourceColumn: mrr_inicial

		annotation SummarizationSetBy = User

	column motivo_perda
		dataType: string
		lineageTag: 2747c901-1c74-4942-a5a5-79281bcfa02a
		summarizeBy: none
		sourceColumn: motivo_perda

		annotation SummarizationSetBy = User

	column num_tentativas_contato
		dataType: int64
		lineageTag: bae37f75-8387-4523-9714-bf370a20b7a7
		summarizeBy: none
		sourceColumn: num_tentativas_contato

