/// Pipeline comercial: resultado real (Ganho/Perdido) para contrastar com o target.
table leads_pipeline
	lineageTag: c989af1c-425a-45e9-8abd-3244e6abea7f

	column id_lead
		dataType: string
		lineageTag: b69d979d-7e3b-4370-bbb7-0c2b9a793fdd
		summarizeBy: none
		sourceColumn: id_lead

		annotation SummarizationSetBy = User

	column id_contador
		dataType: string
		lineageTag: a8c9dcad-9859-4061-a54d-4aa2b166cf7f
		summarizeBy: none
		sourceColumn: id_contador

		annotation SummarizationSetBy = User

	column canal_origem
		dataType: string
		lineageTag: e801f4ab-c006-4195-a5ab-0a6993059b39
		summarizeBy: none
		sourceColumn: canal_origem

		annotation SummarizationSetBy = User

	column id_franquia
		dataType: string
		lineageTag: 0342b33f-049e-4200-adba-0d2ca0e422e4
		summarizeBy: none
		sourceColumn: id_franquia

		annotation SummarizationSetBy = User

	column data_entrada
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 9a005a4a-1a92-4208-861d-96e17b3f30ca
		summarizeBy: none
		sourceColumn: data_entrada

		annotation SummarizationSetBy = User

	column status_lead
		dataType: string
		lineageTag: bcb08b3a-0419-416e-862d-dda5c167654a
		summarizeBy: none
		sourceColumn: status_lead

		annotation SummarizationSetBy = User

	column data_conversao
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 70e89adc-a157-47ee-870e-d868249c7e6a
		summarizeBy: none
		sourceColumn: data_conversao

		annotation SummarizationSetBy = User

	column mrr_inicial
		dataType: double
		lineageTag: 84fe1197-4dcc-485b-a7d3-24b5ac466c5d
		summarizeBy: none
		sourceColumn: mrr_inicial

		annotation SummarizationSetBy = User

	column motivo_perda
		dataType: string
		lineageTag: 4d5caea0-4fcd-46ce-9104-74f702ecc561
		summarizeBy: none
		sourceColumn: motivo_perda

		annotation SummarizationSetBy = User

	column num_tentativas_contato
		dataType: int64
		lineageTag: a977a876-fb4f-49d9-9814-8702b09b8b3c
		summarizeBy: none
		sourceColumn: num_tentativas_contato

		annotation SummarizationSetBy = User

	column tempo_ciclo_dias
		dataType: int64
		lineageTag: bc259b54-d194-4b0e-b788-862d0c3ae645
		summarizeBy: none
		sourceColumn: tempo_ciclo_dias

		annotation SummarizationSetBy = User

	/// 1 = lead Ganho
	column ganho =
			IF(leads_pipeline[status_lead] = "Ganho", 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: f4a71186-e566-4036-8616-85f5f941ae1f
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	/// 1 = lead encerrado (Ganho ou Perdido)
	column com_desfecho =
			IF(leads_pipeline[status_lead] IN {"Ganho", "Perdido"}, 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: 00b244ca-f07a-4173-975a-f4ea30a060b4
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	partition leads_pipeline = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSQL, BancoSQL),
				    Dados = Fonte{[Schema="raw", Item="leads_pipeline"]}[Data],
				    SemLinhaOrigem = Table.RemoveColumns(Dados, {"linha_origem"})
				in
				    SemLinhaOrigem

	annotation PBI_ResultType = Table
