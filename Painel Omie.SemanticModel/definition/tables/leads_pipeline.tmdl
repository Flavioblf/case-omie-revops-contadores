	/// 1 = lead Ganho
	column ganho =
			IF(leads_pipeline[status_lead] = "Ganho", 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: 448f2d97-0b1f-4c57-a861-5dca688a6052
