	/// 1 = lead encerrado (Ganho ou Perdido)
	column com_desfecho =
			IF(leads_pipeline[status_lead] IN {"Ganho", "Perdido"}, 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: 4a7381b4-9e9e-4993-af28-49c52381175d
