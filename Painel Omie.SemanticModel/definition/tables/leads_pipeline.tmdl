/// Pipeline comercial: resultado real (Ganho/Perdido) para contrastar com o target.
table leads_pipeline
	lineageTag: 7b76afdf-cdd8-4aef-9742-7400467282b2

	column id_lead
		dataType: string
		lineageTag: 6991c981-6682-4939-b120-05410f03d6c4
		summarizeBy: none
		sourceColumn: id_lead

		annotation SummarizationSetBy = User

	column id_contador
		dataType: string
		lineageTag: 5eb7dc64-beb7-4f7f-a070-2518cfd2c359
		summarizeBy: none
		sourceColumn: id_contador

		annotation SummarizationSetBy = User

	column canal_origem
		dataType: string
		lineageTag: fa5afe75-5f3a-41e6-8c9a-2ca56e7daa3d
		summarizeBy: none
		sourceColumn: canal_origem

		annotation SummarizationSetBy = User

	column id_franquia
		dataType: string
		lineageTag: 6472f8c1-e719-4dc8-bec3-52dbe27e8b89
		summarizeBy: none
		sourceColumn: id_franquia

		annotation SummarizationSetBy = User

	column data_entrada
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 89bb6711-79f5-4b64-9c2a-0965859ffe41
		summarizeBy: none
		sourceColumn: data_entrada

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column status_lead
		dataType: string
		lineageTag: 0ac06f6f-84c9-4e99-b9b9-2e59655bfe75
		summarizeBy: none
		sourceColumn: status_lead

		annotation SummarizationSetBy = User

	column data_conversao
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: afc936dd-3d47-4886-a558-ed08443a9184
		summarizeBy: none
		sourceColumn: data_conversao

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column mrr_inicial
		dataType: double
		lineageTag: 93eaf33e-fc1d-4082-967a-c817a672a6ef
		summarizeBy: none
		sourceColumn: mrr_inicial

		annotation SummarizationSetBy = User

	column motivo_perda
		dataType: string
		lineageTag: e14dc2b3-0262-45b8-ae26-860f5419bd15
		summarizeBy: none
		sourceColumn: motivo_perda

		annotation SummarizationSetBy = User

	column num_tentativas_contato
		dataType: int64
		lineageTag: 86ef8e1a-7e32-4e1a-b74d-1ae39df8daac
		summarizeBy: none
		sourceColumn: num_tentativas_contato

		annotation SummarizationSetBy = User

	column tempo_ciclo_dias
		dataType: int64
		lineageTag: 9d05c62a-4e1e-4e49-b3c3-48a286e1d3d6
		summarizeBy: none
		sourceColumn: tempo_ciclo_dias

		annotation SummarizationSetBy = User

	/// 1 = lead Ganho
	column ganho = IF(leads_pipeline[status_lead] = "Ganho", 1, 0)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1d5f23e5-bc2b-4fd2-b533-c0b104bbe1a3
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// 1 = lead encerrado (Ganho ou Perdido)
	column com_desfecho = IF(leads_pipeline[status_lead] IN {"Ganho", "Perdido"}, 1, 0)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 90becd71-f17a-41d5-8920-9857faca8eb1
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Trimestre do Ganho (data_conversao)
	column trimestre_ganho = IF(leads_pipeline[status_lead] = "Ganho", FORMAT(YEAR(leads_pipeline[data_conversao]), "0") & " T" & FORMAT(QUARTER(leads_pipeline[data_conversao]), "0"))
		dataType: string
		lineageTag: 773ebbf6-72e0-4e5f-a14d-5601f01e540d
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition leads_pipeline = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSQL, BancoSQL),
				    Dados = Fonte{[Schema="raw", Item="leads_pipeline"]}[Data],
				    SemLinhaOrigem = Table.RemoveColumns(Dados, {"linha_origem"})
				in
				    SemLinhaOrigem

	annotation PBI_ResultType = Table

