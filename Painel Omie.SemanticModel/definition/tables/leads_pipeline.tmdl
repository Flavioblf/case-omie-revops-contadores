/// Pipeline comercial: resultado real (Ganho/Perdido) para contrastar com o target.
table leads_pipeline
	lineageTag: 8c2d8dd5-52e1-4c52-bc86-6b326be332d1

	column id_lead
		dataType: string
		lineageTag: 44a957ec-24d3-4828-b089-06a401308cc0
		summarizeBy: none
		sourceColumn: id_lead

		annotation SummarizationSetBy = User

	column id_contador
		dataType: string
		lineageTag: 0a3f9b33-13cd-4d6e-9668-212112bf13b8
		summarizeBy: none
		sourceColumn: id_contador

		annotation SummarizationSetBy = User

	column canal_origem
		dataType: string
		lineageTag: a106202d-6511-4235-a4bc-3d124a56db10
		summarizeBy: none
		sourceColumn: canal_origem

		annotation SummarizationSetBy = User

	column id_franquia
		dataType: string
		lineageTag: cf6e0597-78d6-446d-b05f-3a107ef485df
		summarizeBy: none
		sourceColumn: id_franquia

		annotation SummarizationSetBy = User

	column data_entrada
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: a6834551-4bc9-44d9-8c1b-da9903e20c2a
		summarizeBy: none
		sourceColumn: data_entrada

		annotation SummarizationSetBy = User

	column status_lead
		dataType: string
		lineageTag: 8e4c732e-4e00-4716-9a50-ec48dd81334b
		summarizeBy: none
		sourceColumn: status_lead

		annotation SummarizationSetBy = User

	column data_conversao
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: b0ef139b-696e-403f-97ee-b9932ffe0b22
		summarizeBy: none
		sourceColumn: data_conversao

		annotation SummarizationSetBy = User

	column mrr_inicial
		dataType: double
		lineageTag: 77617340-4447-40e8-bb9b-8d20ad4ce3cd
		summarizeBy: none
		sourceColumn: mrr_inicial

		annotation SummarizationSetBy = User

	column motivo_perda
		dataType: string
		lineageTag: 64292246-da57-4cbf-8507-7ba110880896
		summarizeBy: none
		sourceColumn: motivo_perda

		annotation SummarizationSetBy = User

	column num_tentativas_contato
		dataType: int64
		lineageTag: 729941b3-04d6-4ec9-b345-610915846db0
		summarizeBy: none
		sourceColumn: num_tentativas_contato

		annotation SummarizationSetBy = User

	column tempo_ciclo_dias
		dataType: int64
		lineageTag: e7cf8644-9824-4a1a-8dec-a76d6f87539b
		summarizeBy: none
		sourceColumn: tempo_ciclo_dias

		annotation SummarizationSetBy = User

	/// 1 = lead Ganho
	column ganho =
			IF(leads_pipeline[status_lead] = "Ganho", 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: aa4fa3e6-c8d1-475c-bf5b-8f151b369b8f
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	/// 1 = lead encerrado (Ganho ou Perdido)
	column com_desfecho =
			IF(leads_pipeline[status_lead] IN {"Ganho", "Perdido"}, 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: 2f9d4f15-43ae-456b-8a4b-dfc896cb6a0b
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	partition leads_pipeline = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSQL, BancoSQL),
				    Dados = Fonte{[Schema="raw", Item="leads_pipeline"]}[Data],
				    SemLinhaOrigem = Table.RemoveColumns(Dados, {"linha_origem"})
				in
				    SemLinhaOrigem

	annotation PBI_ResultType = Table
