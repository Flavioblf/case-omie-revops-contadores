/// Pipeline comercial: resultado real (Ganho/Perdido) para contrastar com o target.
table leads_pipeline
	lineageTag: 6f5a51cf-26ad-4e2c-b336-7c7d42017b59

	column id_lead
		dataType: string
		lineageTag: d545e6f7-19fc-430b-8902-b71f7b246b47
		summarizeBy: none
		sourceColumn: id_lead

		annotation SummarizationSetBy = User

	column id_contador
		dataType: string
		lineageTag: 140c7ce0-9b9d-42cf-b7b6-4bee8e75a9b6
		summarizeBy: none
		sourceColumn: id_contador

		annotation SummarizationSetBy = User

	column canal_origem
		dataType: string
		lineageTag: 795a253a-b304-4885-b5bd-de2e7c9fe3d9
		summarizeBy: none
		sourceColumn: canal_origem

		annotation SummarizationSetBy = User

	column id_franquia
		dataType: string
		lineageTag: f3528b75-d32a-4e8a-951c-e73a3c52372f
		summarizeBy: none
		sourceColumn: id_franquia

		annotation SummarizationSetBy = User

	column data_entrada
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: f7c27750-1c68-41f9-a64b-38960d916d42
		summarizeBy: none
		sourceColumn: data_entrada

		annotation SummarizationSetBy = User

	column status_lead
		dataType: string
		lineageTag: 1433c331-fb4f-41cd-b53c-6e93184217b7
		summarizeBy: none
		sourceColumn: status_lead

		annotation SummarizationSetBy = User

	column data_conversao
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: b2bf0979-45fd-4905-8847-909313a81996
		summarizeBy: none
		sourceColumn: data_conversao

		annotation SummarizationSetBy = User

	column mrr_inicial
		dataType: double
		lineageTag: 73f8d451-2497-4121-8228-ca965d220775
		summarizeBy: none
		sourceColumn: mrr_inicial

		annotation SummarizationSetBy = User

	column motivo_perda
		dataType: string
		lineageTag: 05dd500e-36a8-4599-8a44-b8bc8a0ebd86
		summarizeBy: none
		sourceColumn: motivo_perda

		annotation SummarizationSetBy = User

	column num_tentativas_contato
		dataType: int64
		lineageTag: 8522b3e8-54b9-4bd5-923a-e0f28251986d
		summarizeBy: none
		sourceColumn: num_tentativas_contato

		annotation SummarizationSetBy = User

	column tempo_ciclo_dias
		dataType: int64
		lineageTag: 6aba92c8-9c8b-45ce-b1c6-074c4abe01f3
		summarizeBy: none
		sourceColumn: tempo_ciclo_dias

		annotation SummarizationSetBy = User

	/// 1 = lead Ganho
	column ganho =
			IF(leads_pipeline[status_lead] = "Ganho", 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: c530b818-4f20-4b68-9ac2-65b2e2cec543
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	/// Trimestre do Ganho (data_conversao)
	column trimestre_ganho =
			IF(leads_pipeline[status_lead] = "Ganho", FORMAT(YEAR(leads_pipeline[data_conversao]), "0") & " T" & FORMAT(QUARTER(leads_pipeline[data_conversao]), "0"))
		dataType: string
		lineageTag: 30ad94b5-e51a-4ddd-ac6c-7374747af26c
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// 1 = lead encerrado (Ganho ou Perdido)
	column com_desfecho =
			IF(leads_pipeline[status_lead] IN {"Ganho", "Perdido"}, 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: 8087fda3-121e-4f9f-825c-fb041bb24ac9
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	partition leads_pipeline = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSQL, BancoSQL),
				    Dados = Fonte{[Schema="raw", Item="leads_pipeline"]}[Data],
				    SemLinhaOrigem = Table.RemoveColumns(Dados, {"linha_origem"})
				in
				    SemLinhaOrigem

	annotation PBI_ResultType = Table
