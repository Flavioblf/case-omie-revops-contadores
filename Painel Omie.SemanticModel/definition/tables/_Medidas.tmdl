/// Tabela de medidas do Desafio 2.
table _Medidas
	lineageTag: 6754437f-62fd-442f-9b49-7804459324e8

	/// Nº de contadores no contexto
	measure Contadores = COUNTROWS(mercado_contadores)
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: 77419009-0c86-43c7-8011-7941b5ac0fd5

	/// Contadores com converteu_omie = 1
	measure Convertidos = SUM(mercado_contadores[converteu_omie])
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: c708deae-a461-4964-9224-c6b937ed1655

	/// Convertidos ÷ contadores
	measure 'Taxa de Conversão' = DIVIDE([Convertidos], [Contadores])
		formatString: 0.0%
		displayFolder: 1. Base
		lineageTag: d73aac6f-2158-4cc4-af7c-1ec4fc245c12

	/// Taxa do grupo ÷ taxa média
	measure 'Lift vs Média' = DIVIDE([Taxa de Conversão], [Taxa Média])
		formatString: 0.0"x"
		displayFolder: 1. Base
		lineageTag: 47d10980-59df-42bf-8a20-2f2a1bebc9d0

	/// Leads no pipeline
	measure Leads = COUNTROWS(leads_pipeline)
		formatString: #,0
		displayFolder: 3. Resultado Real
		lineageTag: 89ad2c11-3f90-4ad8-a1c5-37f5c6ad1c82

	/// Leads Ganho + Perdido
	measure 'Leads com Desfecho' = SUM(leads_pipeline[com_desfecho])
		formatString: #,0
		displayFolder: 3. Resultado Real
		lineageTag: 8c367f97-7841-46e9-a0c9-5d863f6df1e3

	/// Leads Ganho
	measure 'Ganhos (Real)' = SUM(leads_pipeline[ganho])
		formatString: #,0
		displayFolder: 3. Resultado Real
		lineageTag: f9c4cbd1-eae8-4d75-99fe-973c4f95c80f

	/// Ganho ÷ (Ganho + Perdido): o fechamento comercial de verdade
	measure 'Win Rate Real' = DIVIDE([Ganhos (Real)], [Leads com Desfecho])
		formatString: 0.0%
		displayFolder: 3. Resultado Real
		lineageTag: 75870c60-b78b-48c6-b474-41def4f46eba

	/// Contadores endereçáveis (regra do Desafio 1a)
	measure Endereçáveis = CALCULATE([Contadores], mercado_contadores[enderecavel] = "Sim")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 4ee80fc8-e18b-4266-ad57-2f911e369bd2

	/// Endereçáveis com perfil ICP
	measure 'ICP Endereçáveis' = CALCULATE([Endereçáveis], mercado_contadores[icp] = "Sim")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: d1b47aa0-a6ce-4b1e-9a4e-3274647fdd09

	/// Clientes finais nas carteiras dos endereçáveis
	measure 'Carteira Endereçável' = CALCULATE(SUM(mercado_contadores[num_clientes_ativos]), mercado_contadores[enderecavel] = "Sim")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 700c3fb8-dbbb-46ab-b4e6-fdebbfd8efe5

	/// nMRR oficial mensal (R$) das franquias abaixo da meta
	measure 'Realizado Franquias Abaixo da Meta' = SUMX(FILTER(ALLNOBLANKROW(franquias), franquias[realizado_nmrr_mes] < franquias[meta_nmrr_mes]), franquias[realizado_nmrr_mes])
		formatString: #,0
		displayFolder: 5. Impacto
		lineageTag: 53bcfeec-dcd9-478e-940f-33ffa9438dee

	/// Parte da capacidade dos ECs levada ao topo da propensão
	measure '% Capacidade Redirecionada' = SELECTEDVALUE(Param_Cenarios[pct_redirecionado])
		formatString: 0%
		displayFolder: 5. Impacto
		lineageTag: d0b8fbb8-1051-41ea-ab6f-5f8b687727c3

	/// Fração do lift que vira Ganho real (o target diverge do real)
	measure 'Fator de Realização' = SELECTEDVALUE(Param_Cenarios[fator_realizacao])
		formatString: 0%
		displayFolder: 5. Impacto
		lineageTag: 02762007-dc1a-4176-8725-95f64dfb291f

	/// % capacidade × (lift do top 30% do score − 1) × fator de realização
	measure 'Uplift nMRR' = [% Capacidade Redirecionada] * ([Lift Top 30%] - 1) * [Fator de Realização]
		formatString: +0.0%
		displayFolder: 5. Impacto
		lineageTag: 31e83af4-7f24-43e2-8e6a-2849b9bb3772

	/// Uplift aplicado ao nMRR oficial dessas franquias (R$/mês)
	measure 'nMRR Incremental (Franquias Abaixo da Meta)' = [Uplift nMRR] * [Realizado Franquias Abaixo da Meta]
		formatString: #,0
		displayFolder: 5. Impacto
		lineageTag: 7158d01a-03d3-4e0b-8249-77ab6a7cb63c

	/// Taxa dos 600 contadores
	measure 'Taxa Média' = CALCULATE([Taxa de Conversão], REMOVEFILTERS(mercado_contadores))
		formatString: 0.0%
		displayFolder: 1. Base
		lineageTag: 35f616f7-5a6a-4697-8edc-2cc467e0c727

	/// Maior − menor taxa de conversão entre as categorias (30+ contadores): quanto a característica separa quem converte
	measure 'Amplitude (p.p.)' =
			SWITCH(SELECTEDVALUE(Param_Variaveis[variavel]),
			    "Porte",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[porte]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "Nº de funcionários",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[faixa_funcionarios]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "Nº de clientes da carteira",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[faixa_carteira]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "ERP atual",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[erp_atual]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "Anos de mercado",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[faixa_anos]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "Região",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[regiao]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "Segmento",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[segmento_principal]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "Tem site",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[tem_site]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "LinkedIn",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[presenca_linkedin]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100)
		formatString: 0
		displayFolder: 2. Drivers
		lineageTag: b771892e-0a7c-43be-8c38-e9fa62d60be9

	/// 1 = driver mais forte
	measure 'Ranking do Driver' = RANKX(ALL(Param_Variaveis), [Amplitude (p.p.)])
		formatString: 0
		displayFolder: 2. Drivers
		lineageTag: d88cc7de-e1b6-47f0-9231-01e883768db5

	/// Taxa do ICP
	measure 'Taxa de Conversão ICP' = CALCULATE([Taxa de Conversão], mercado_contadores[icp] = "Sim")
		formatString: 0.0%
		displayFolder: 2. Drivers
		lineageTag: 4e18d226-7b42-41ba-901e-c3f5d97dc19a

	/// Taxa do ICP ÷ taxa média
	measure 'Lift do ICP' = DIVIDE([Taxa de Conversão ICP], [Taxa Média])
		formatString: 0.0"x"
		displayFolder: 2. Drivers
		lineageTag: 964b1da3-5aad-40e7-8190-3a8474f01d0d

	/// Win rate real do ICP
	measure 'Win Rate Real ICP' = CALCULATE([Win Rate Real], mercado_contadores[icp] = "Sim")
		formatString: 0.0%
		displayFolder: 3. Resultado Real
		lineageTag: 5bdc2c90-343b-410c-98b6-72dbb64f0f89

	/// Win rate real de quem não é ICP
	measure 'Win Rate Real Fora do ICP' = CALCULATE([Win Rate Real], mercado_contadores[icp] = "Não")
		formatString: 0.0%
		displayFolder: 3. Resultado Real
		lineageTag: a4585860-e2d6-4548-9753-d72d537a1d08

	/// Endereçáveis no tier Alta do Desafio 1c
	measure 'Tier Alta' = CALCULATE([Endereçáveis], mercado_contadores[tier_prioridade] = "Alta")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 8b2929dd-1504-4321-a16c-29137cb6a468

	/// Nº de franquias abaixo da meta
	measure 'Franquias Abaixo da Meta' = COUNTROWS(FILTER(ALLNOBLANKROW(franquias), franquias[realizado_nmrr_mes] < franquias[meta_nmrr_mes]))
		formatString: 0
		displayFolder: 6. Desafio 3
		lineageTag: c0f4d692-f7f3-40ba-95c9-538f30d68dcf

	/// Correlação de Pearson entre meses de operação e atingimento (≈ 0,65)
	measure 'Correlação Maturidade × Atingimento' =
			VAR t = ALLNOBLANKROW(franquias)
			VAR mx = AVERAGEX(t, franquias[meses_operando])
			VAR my = AVERAGEX(t, franquias[atingimento])
			VAR cov = SUMX(t, (franquias[meses_operando] - mx) * (franquias[atingimento] - my))
			VAR sx = SQRT(SUMX(t, (franquias[meses_operando] - mx) ^ 2))
			VAR sy = SQRT(SUMX(t, (franquias[atingimento] - my) ^ 2))
			RETURN DIVIDE(cov, sx * sy)
		formatString: 0.00
		displayFolder: 6. Desafio 3
		lineageTag: 64db8895-f7f6-45fe-b6ea-a566120de116

	/// Gap de meta no contexto (R$/mês)
	measure 'Gap (R$)' = SUM(franquias[gap])
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: a6d27eb7-ee73-44dd-893e-c85abef00153

	/// Atingimento quando abaixo de 100%
	measure 'Atingimento (abaixo da meta)' = VAR a = DIVIDE(SUM(franquias[realizado_nmrr_mes]), SUM(franquias[meta_nmrr_mes])) RETURN IF(a < 1, a)
		formatString: 0%
		displayFolder: 6. Desafio 3
		lineageTag: 452e5301-da75-4376-82cc-9e59fcaf7491

	/// Atingimento quando 100% ou mais
	measure 'Atingimento (na meta)' = VAR a = DIVIDE(SUM(franquias[realizado_nmrr_mes]), SUM(franquias[meta_nmrr_mes])) RETURN IF(a >= 1, a)
		formatString: 0%
		displayFolder: 6. Desafio 3
		lineageTag: e22f3b0c-1155-486d-93a4-044c94e76b97

	/// Nº de ECs
	measure ECs = SUM(franquias[num_executivos])
		formatString: 0
		displayFolder: 6. Desafio 3
		lineageTag: 3de157fd-0a0e-4da0-bad0-6c1089bdea03

	/// Endereçáveis do território da franquia
	measure 'Prospects no Território' = COUNTROWS(FILTER(ALL(mercado_contadores), mercado_contadores[franquia_responsavel] = SELECTEDVALUE(franquias[id_franquia]) && mercado_contadores[enderecavel] = "Sim"))
		formatString: 0
		displayFolder: 6. Desafio 3
		lineageTag: 9a784bdd-ee68-4665-b371-30b793f19ccd

	/// Endereçáveis do tier Alta no território
	measure 'Tier Alta no Território' = COUNTROWS(FILTER(ALL(mercado_contadores), mercado_contadores[franquia_responsavel] = SELECTEDVALUE(franquias[id_franquia]) && mercado_contadores[tier_prioridade] = "Alta"))
		formatString: 0
		displayFolder: 6. Desafio 3
		lineageTag: 06dfde87-8f3b-4daf-b008-463f4c75b241

	/// nMRR oficial por EC
	measure 'Realizado por EC' = DIVIDE(SUM(franquias[realizado_nmrr_mes]), [ECs])
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: fc1e3e52-08b9-48a5-bf18-440df057c35e

	/// 1 = franquia com mais fechamentos potenciais por EC (onde alocar o EC adicional)
	measure 'Ranking EC Adicional' = IF(HASONEVALUE(franquias[id_franquia]), RANKX(ALLNOBLANKROW(franquias), [Fechamentos Potenciais por EC]))
		formatString: 0
		displayFolder: 6. Desafio 3
		lineageTag: 9776ae2e-116d-421d-9f7f-f07f7d867d96

	/// Franquia com mais fechamentos potenciais por EC
	measure 'Franquia Recomendada' = SUBSTITUTE(MAXX(TOPN(1, ALLNOBLANKROW(franquias), [Fechamentos Potenciais por EC]), franquias[nome_franquia]), "Franquia ", "")
		displayFolder: 6. Desafio 3
		lineageTag: 986757fe-e9a9-4b3a-b6f4-48a2e669a362

	/// Taxa de conversão (target) da faixa Alta de propensão
	measure 'Conversão Top 30%' = CALCULATE([Taxa de Conversão], REMOVEFILTERS(mercado_contadores), mercado_contadores[faixa_propensao] = "Alta")
		formatString: 0%
		displayFolder: 2. Drivers
		lineageTag: 19da84b0-4aec-4c10-9521-90c7f6ed17e2

	/// Conversão do top 30% ÷ média
	measure 'Lift Top 30%' = DIVIDE([Conversão Top 30%], [Taxa Média])
		formatString: 0.0"x"
		displayFolder: 2. Drivers
		lineageTag: 0732fdd5-6be1-4fa2-9b7a-7b33213de99f

	/// % dos convertidos que estão no top 30% do score
	measure 'Captura Top 30%' = DIVIDE(CALCULATE([Convertidos], REMOVEFILTERS(mercado_contadores), mercado_contadores[faixa_propensao] = "Alta"), CALCULATE([Convertidos], REMOVEFILTERS(mercado_contadores)))
		formatString: 0%
		displayFolder: 2. Drivers
		lineageTag: 6012fc4e-9173-41af-8721-5f3c4a8f8f19

	/// Win rate real do top 30% do score
	measure 'Win Rate Real Faixa Alta' = CALCULATE([Win Rate Real], REMOVEFILTERS(mercado_contadores), mercado_contadores[faixa_propensao] = "Alta")
		formatString: 0%
		displayFolder: 3. Resultado Real
		lineageTag: 79960474-559d-404b-9b08-78914a953c98

	/// Win rate real das faixas Média e Baixa
	measure 'Win Rate Real Demais Faixas' = CALCULATE([Win Rate Real], REMOVEFILTERS(mercado_contadores), mercado_contadores[faixa_propensao] <> "Alta")
		formatString: 0%
		displayFolder: 3. Resultado Real
		lineageTag: 9e8c7a15-a8a8-43ed-92e7-59af9d27d341

	/// Endereçáveis no tier Média do Desafio 1c
	measure 'Tier Média' = CALCULATE([Endereçáveis], mercado_contadores[tier_prioridade] = "Média")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: df510410-40e9-411a-bd49-3b7fe07a7246

	/// Endereçáveis no tier Baixa do Desafio 1c
	measure 'Tier Baixa' = CALCULATE([Endereçáveis], mercado_contadores[tier_prioridade] = "Baixa")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: aeda5a69-8191-4fde-9a6f-53c924a26e1c

	/// Endereçáveis com lead em Reunião/Proposta nos últimos 90 dias
	measure Quente = CALCULATE([Endereçáveis], mercado_contadores[engajamento] = "Quente")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 9485d8ab-9f51-40ec-969d-f0403c604c23

	/// Endereçáveis com lead Novo/Em Contato nos últimos 90 dias
	measure Morno = CALCULATE([Endereçáveis], mercado_contadores[engajamento] = "Morno")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: d4f4e997-70d4-4a29-9402-f0d4f1e703da

	/// Endereçáveis sem lead ativo (inclui parados há mais de 90 dias)
	measure Frio = CALCULATE([Endereçáveis], mercado_contadores[engajamento] = "Frio")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: e5eb4309-d1e0-45ed-bcdd-0d3269c2d73b

	/// Soma do MRR esperado dos endereçáveis
	measure 'MRR Esperado' = SUM(mercado_contadores[mrr_esperado])
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: aacb976a-3840-4761-8301-60822f4e13c4

	/// Endereçáveis nas ondas 1 (fechar) e 2 (prospectar tier Alta)
	measure 'Contadores Ondas 1 e 2' = CALCULATE([Endereçáveis], mercado_contadores[onda] <= 2)
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 5913d037-39ce-4a32-8a9e-2d6f4764f31a

	/// Canal com menos tentativas de contato por fechamento (Desafio 1b)
	measure 'Melhor ROI de Esforço' = MAXX(FILTER(d1b_conversao, d1b_conversao[ranking_roi_esforco] = 1), d1b_conversao[canal_origem])
		displayFolder: 4. Priorização
		lineageTag: f26e9878-7a1e-4038-82dc-1c152ab37355

	/// Endereçáveis do território ÷ ECs
	measure 'Prospects por EC' = DIVIDE([Prospects no Território], [ECs])
		formatString: 0.0
		displayFolder: 6. Desafio 3
		lineageTag: 88bab71e-5b41-4004-87e2-e56c840ea333

	/// Meta de nMRR por EC
	measure 'Meta por EC' = DIVIDE(SUM(franquias[meta_nmrr_mes]), [ECs])
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: 260021ee-980d-4385-972b-e05f32a6563c

	/// Meta de nMRR (R$/mês)
	measure 'Meta (R$)' = SUM(franquias[meta_nmrr_mes])
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: 714d1e39-635d-45f9-ac7e-17e527a51136

	/// Realizado de nMRR (R$/mês)
	measure 'Realizado (R$)' = SUM(franquias[realizado_nmrr_mes])
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: 8a660727-6ec3-483e-8d15-c609c622d36d

	/// Fechamentos ÷ leads trabalhados (execucao_comercial, 2024)
	measure 'Conversão do Funil' = DIVIDE(SUM(execucao_comercial[fechamentos]), SUM(execucao_comercial[leads_trabalhados]))
		formatString: 0.0%
		displayFolder: 6. Desafio 3
		lineageTag: d55f211e-29d4-493c-966a-d138cdedc590

	/// Endereçáveis por EC × conversão do funil da franquia
	measure 'Fechamentos Potenciais por EC' = [Prospects por EC] * [Conversão do Funil]
		formatString: 0.00
		displayFolder: 6. Desafio 3
		lineageTag: db1d5745-e26a-4807-a4a5-4aa9cc90e025

	/// Parte do realizado que preenche a meta (barra de progresso)
	measure 'Realizado até a Meta' = IF(NOT ISBLANK([Meta (R$)]), MIN([Realizado (R$)], [Meta (R$)]))
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: f98d2e8c-b124-411e-a9ba-f6cee87163cd

	/// O que falta para bater a meta
	measure 'Falta para a Meta' = IF(NOT ISBLANK([Meta (R$)]), MAX([Meta (R$)] - [Realizado (R$)], 0))
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: 7ea33c48-7ef5-4410-a78c-0f8f9cdee4ab

	/// O que passou da meta
	measure 'Acima da Meta' = IF(NOT ISBLANK([Meta (R$)]), MAX([Realizado (R$)] - [Meta (R$)], 0))
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: c6d90341-741e-4c6e-a6ec-229101d76d9e

	/// Realizado ÷ meta no contexto (franquia ou região)
	measure Atingimento = DIVIDE([Realizado (R$)], [Meta (R$)])
		formatString: 0%
		displayFolder: 6. Desafio 3
		lineageTag: 4e92c7cd-1c73-41de-b0f8-f9cf27827611

	/// Realizado por EC ÷ realizado por EC da rede
	measure 'Realizado por EC vs Rede' = DIVIDE([Realizado por EC], DIVIDE(SUMX(ALLNOBLANKROW(franquias), franquias[realizado_nmrr_mes]), SUMX(ALLNOBLANKROW(franquias), franquias[num_executivos])))
		formatString: 0%
		displayFolder: 6. Desafio 3
		lineageTag: e2f102fe-a8a6-4a5b-9007-1b0c6f98fe99

	/// Média de fechamentos por EC por mês (execucao_comercial)
	measure 'Fechamentos por EC-mês' = AVERAGE(execucao_comercial[fechamentos])
		formatString: 0.00
		displayFolder: 6. Desafio 3
		lineageTag: 9f350543-baa3-403d-951c-a1650c72c0ef

	/// % dos EC-mês sem nenhum fechamento (dispersão entre ECs)
	measure '% EC-mês sem Fechamento' = DIVIDE(COUNTROWS(FILTER(execucao_comercial, execucao_comercial[fechamentos] = 0)), COUNTROWS(execucao_comercial))
		formatString: 0%
		displayFolder: 6. Desafio 3
		lineageTag: 109bdbb7-8f9c-424b-b49a-fe87b8f7ef70

	column Coluna
		dataType: string
		isHidden
		lineageTag: 9e1db163-f713-47f9-a4d8-2ee928a13e40
		summarizeBy: none
		sourceColumn: Coluna

		annotation SummarizationSetBy = User

	partition _Medidas = m
		mode: import
		source =
				let
				    Fonte = #table(type table [Coluna = text], {})
				in
				    Fonte

	annotation PBI_ResultType = Table

