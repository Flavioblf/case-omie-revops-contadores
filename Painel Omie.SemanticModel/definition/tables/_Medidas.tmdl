/// Tabela de medidas do Desafio 2.
table _Medidas
	lineageTag: 887763aa-460c-4a37-94a3-0c0caf60736d

	/// Nº de contadores no contexto
	measure Contadores =
			COUNTROWS(mercado_contadores)
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: 52c2145f-aecf-4ec7-b0e6-1771f906af31

	/// Contadores com converteu_omie = 1
	measure Convertidos =
			SUM(mercado_contadores[converteu_omie])
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: 4cfb2285-b5e9-4540-8c2c-e52617e62300

	/// Convertidos ÷ contadores
	measure 'Taxa de Conversão' =
			DIVIDE([Convertidos], [Contadores])
		formatString: 0.0%
		displayFolder: 1. Base
		lineageTag: 2f758774-b9c9-4237-8b6e-4dc98be2cf88

	/// Taxa dos 600 contadores
	measure 'Taxa Média' =
			CALCULATE([Taxa de Conversão], REMOVEFILTERS(mercado_contadores))
		formatString: 0.0%
		displayFolder: 1. Base
		lineageTag: c1dd1b00-f241-47b9-a0a5-0ec98b69f56f

	/// Taxa do grupo ÷ taxa média
	measure 'Lift vs Média' =
			DIVIDE([Taxa de Conversão], [Taxa Média])
		formatString: 0.0"x"
		displayFolder: 1. Base
		lineageTag: 32c6139b-6255-4838-a943-e34c226f0d9c

	/// Maior − menor taxa de conversão entre as categorias (30+ contadores): quanto a característica separa quem converte
	measure 'Amplitude (p.p.)' =
			SWITCH(SELECTEDVALUE(Param_Variaveis[variavel]),
			    "Porte",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[porte]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "Nº de funcionários",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[faixa_funcionarios]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "Nº de clientes da carteira",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[faixa_carteira]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "ERP atual",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[erp_atual]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "Anos de mercado",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[faixa_anos]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "Região",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[regiao]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "Segmento",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[segmento_principal]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "Tem site",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[tem_site]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100,
			    "LinkedIn",
			        VAR t = FILTER(ADDCOLUMNS(ALL(mercado_contadores[presenca_linkedin]), "@n", CALCULATE(COUNTROWS(mercado_contadores)), "@tx", CALCULATE([Taxa de Conversão])), [@n] >= 30)
			        RETURN (MAXX(t, [@tx]) - MINX(t, [@tx])) * 100)
		formatString: 0
		displayFolder: 2. Drivers
		lineageTag: f023df6d-ff3a-426e-be72-53f726e5ad66

	/// 1 = driver mais forte
	measure 'Ranking do Driver' =
			RANKX(ALL(Param_Variaveis), [Amplitude (p.p.)])
		formatString: 0
		displayFolder: 2. Drivers
		lineageTag: b3893567-6a94-4f08-9a53-6d136096b194

	/// Taxa do ICP
	measure 'Taxa de Conversão ICP' =
			CALCULATE([Taxa de Conversão], mercado_contadores[icp] = "Sim")
		formatString: 0.0%
		displayFolder: 2. Drivers
		lineageTag: 6a7a319c-9af2-463e-a38e-ab29626cb9d2

	/// Taxa do ICP ÷ taxa média
	measure 'Lift do ICP' =
			DIVIDE([Taxa de Conversão ICP], [Taxa Média])
		formatString: 0.0"x"
		displayFolder: 2. Drivers
		lineageTag: fb9205eb-a49b-467a-bb8d-09a1e5fd7ec5

	/// Taxa de conversão (target) da faixa Alta de propensão
	measure 'Conversão Top 30%' =
			CALCULATE([Taxa de Conversão], REMOVEFILTERS(mercado_contadores), mercado_contadores[faixa_propensao] = "Alta")
		formatString: 0%
		displayFolder: 2. Drivers
		lineageTag: 2b2c0ed7-3217-4c6b-99bd-e2beb702cabd

	/// Conversão do top 30% ÷ média
	measure 'Lift Top 30%' =
			DIVIDE([Conversão Top 30%], [Taxa Média])
		formatString: 0.0"x"
		displayFolder: 2. Drivers
		lineageTag: 8cd4f76a-57e1-4ce7-8ebf-46e5fb404d07

	/// % dos convertidos que estão no top 30% do score
	measure 'Captura Top 30%' =
			DIVIDE(CALCULATE([Convertidos], REMOVEFILTERS(mercado_contadores), mercado_contadores[faixa_propensao] = "Alta"), CALCULATE([Convertidos], REMOVEFILTERS(mercado_contadores)))
		formatString: 0%
		displayFolder: 2. Drivers
		lineageTag: 918c65b9-370c-44d4-8bfb-81cd24a949f3

	/// Leads no pipeline
	measure Leads =
			COUNTROWS(leads_pipeline)
		formatString: #,0
		displayFolder: 3. Resultado Real
		lineageTag: ae66ac9a-f55d-4ec7-a5c6-94101320892c

	/// Leads Ganho + Perdido
	measure 'Leads com Desfecho' =
			SUM(leads_pipeline[com_desfecho])
		formatString: #,0
		displayFolder: 3. Resultado Real
		lineageTag: 27aeb904-5677-4805-bd3a-218af65367ff

	/// Leads Ganho
	measure 'Ganhos (Real)' =
			SUM(leads_pipeline[ganho])
		formatString: #,0
		displayFolder: 3. Resultado Real
		lineageTag: 3de8e021-fcb2-4b3d-862b-a3b86f20795e

	/// Ganhos ÷ leads do pipeline: a conversão comercial real (compare com o converteu_omie)
	measure 'Conversão Real (Pipeline)' =
			DIVIDE([Ganhos (Real)], [Leads])
		formatString: 0.0%
		displayFolder: 3. Resultado Real
		lineageTag: 8b17d721-38c1-4baf-a9cb-a2913b8f44e8

	/// Ganho ÷ (Ganho + Perdido): o fechamento comercial de verdade
	measure 'Win Rate Real' =
			DIVIDE([Ganhos (Real)], [Leads com Desfecho])
		formatString: 0.0%
		displayFolder: 3. Resultado Real
		lineageTag: a40a24eb-3c19-4dd3-af66-98888545b8ac

	/// Win rate real do ICP
	measure 'Win Rate Real ICP' =
			CALCULATE([Win Rate Real], mercado_contadores[icp] = "Sim")
		formatString: 0.0%
		displayFolder: 3. Resultado Real
		lineageTag: 5d872dde-fe2b-4ee6-bc7e-5f2767b6cb7e

	/// Win rate real de quem não é ICP
	measure 'Win Rate Real Fora do ICP' =
			CALCULATE([Win Rate Real], mercado_contadores[icp] = "Não")
		formatString: 0.0%
		displayFolder: 3. Resultado Real
		lineageTag: 76558acd-3298-4e09-a21b-566359730510

	/// Win rate real do top 30% do score
	measure 'Win Rate Real Faixa Alta' =
			CALCULATE([Win Rate Real], REMOVEFILTERS(mercado_contadores), mercado_contadores[faixa_propensao] = "Alta")
		formatString: 0%
		displayFolder: 3. Resultado Real
		lineageTag: 586bcde3-22b1-4b75-ab51-f8a28941b271

	/// Win rate real das faixas Média e Baixa
	measure 'Win Rate Real Demais Faixas' =
			CALCULATE([Win Rate Real], REMOVEFILTERS(mercado_contadores), mercado_contadores[faixa_propensao] <> "Alta")
		formatString: 0%
		displayFolder: 3. Resultado Real
		lineageTag: e6c4e2a2-35dd-45f2-8dba-f5032c285f62

	/// Contadores endereçáveis (regra do Desafio 1a)
	measure 'Endereçáveis' =
			CALCULATE([Contadores], mercado_contadores[enderecavel] = "Sim")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 980b1e1a-dd82-413a-9f14-fdcbbbaba9bd

	/// Endereçáveis no tier Alta do Desafio 1c
	measure 'Tier Alta' =
			CALCULATE([Endereçáveis], mercado_contadores[tier_prioridade] = "Alta")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 3d137aad-26a2-4365-9654-254e53919553

	/// Endereçáveis com perfil ICP
	measure 'ICP Endereçáveis' =
			CALCULATE([Endereçáveis], mercado_contadores[icp] = "Sim")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: b7c63983-204c-4b99-830d-680c7520268c

	/// Endereçáveis no tier Média do Desafio 1c
	measure 'Tier Média' =
			CALCULATE([Endereçáveis], mercado_contadores[tier_prioridade] = "Média")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 3cb1f0c5-7fa9-4e63-85cf-19c920859a7e

	/// Endereçáveis no tier Baixa do Desafio 1c
	measure 'Tier Baixa' =
			CALCULATE([Endereçáveis], mercado_contadores[tier_prioridade] = "Baixa")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: bf10f96c-26dd-4c46-a40d-ac5ea511566d

	/// Endereçáveis com lead em Reunião/Proposta nos últimos 90 dias
	measure Quente =
			CALCULATE([Endereçáveis], mercado_contadores[engajamento] = "Quente")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 5eb46e09-5124-460c-a51f-eba31fd4ae87

	/// Endereçáveis com lead Novo/Em Contato nos últimos 90 dias
	measure Morno =
			CALCULATE([Endereçáveis], mercado_contadores[engajamento] = "Morno")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 9e56e26c-e20b-4dac-b389-04398a2b8d35

	/// Endereçáveis sem lead ativo (inclui parados há mais de 90 dias)
	measure Frio =
			CALCULATE([Endereçáveis], mercado_contadores[engajamento] = "Frio")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 6ca9acec-11da-46a8-a322-51cca6d55a27

	/// Soma do MRR esperado dos endereçáveis
	measure 'MRR Esperado' =
			SUM(mercado_contadores[mrr_esperado])
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 19bc4e87-2bf4-4aed-bb5f-a6c2a2337ebc

	/// Endereçáveis nas ondas 1 (fechar) e 2 (prospectar tier Alta)
	measure 'Contadores Ondas 1 e 2' =
			CALCULATE([Endereçáveis], mercado_contadores[onda] <= 2)
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 459eb9b7-e88d-436f-83b7-64b83c4c7954

	/// Canal com menos tentativas de contato por fechamento (Desafio 1b)
	measure 'Melhor ROI de Esforço' =
			MAXX(FILTER(d1b_conversao, d1b_conversao[ranking_roi_esforco] = 1), d1b_conversao[canal_origem])
		displayFolder: 4. Priorização
		lineageTag: 5a1b7d99-064e-40d1-ad46-89e9181c6fcb

	/// Clientes finais nas carteiras dos endereçáveis
	measure 'Carteira Endereçável' =
			CALCULATE(SUM(mercado_contadores[num_clientes_ativos]), mercado_contadores[enderecavel] = "Sim")
		formatString: #,0
		displayFolder: 4. Priorização
		lineageTag: 749155e1-5309-488e-b750-edacd84dfc21

	/// nMRR oficial mensal (R$) das franquias abaixo da meta
	measure 'Realizado Franquias Abaixo da Meta' =
			SUMX(FILTER(ALLNOBLANKROW(franquias), franquias[realizado_nmrr_mes] < franquias[meta_nmrr_mes]), franquias[realizado_nmrr_mes])
		formatString: #,0
		displayFolder: 5. Impacto
		lineageTag: b7047213-33a7-4ebd-8b72-beb35f711a4b

	/// Parte da capacidade dos ECs levada ao topo da propensão
	measure '% Capacidade Redirecionada' =
			SELECTEDVALUE(Param_Cenarios[pct_redirecionado])
		formatString: 0%
		displayFolder: 5. Impacto
		lineageTag: c7964501-00b8-41c6-a77a-d7604f64aabc

	/// Fração do lift que vira Ganho real (o target diverge do real)
	measure 'Fator de Realização' =
			SELECTEDVALUE(Param_Cenarios[fator_realizacao])
		formatString: 0%
		displayFolder: 5. Impacto
		lineageTag: 13ab709d-4f57-4d91-b26b-628f0def5324

	/// % capacidade × (lift do top 30% do score − 1) × fator de realização
	measure 'Uplift nMRR' =
			[% Capacidade Redirecionada] * ([Lift Top 30%] - 1) * [Fator de Realização]
		formatString: +0.0%
		displayFolder: 5. Impacto
		lineageTag: 12a8f2c6-359a-4819-bdd7-2d741b15cfe4

	/// Uplift aplicado ao nMRR oficial dessas franquias (R$/mês)
	measure 'nMRR Incremental (Franquias Abaixo da Meta)' =
			[Uplift nMRR] * [Realizado Franquias Abaixo da Meta]
		formatString: #,0
		displayFolder: 5. Impacto
		lineageTag: 8b69cb25-1f4c-4581-86df-2d17db659006

	/// Chance de o lead fechar a partir do estágio atual: produto das taxas do funil que faltam (execucao_comercial)
	measure 'Chance de Fechar' =
			VAR lr = CALCULATE(DIVIDE(SUM(execucao_comercial[reunioes_realizadas]), SUM(execucao_comercial[leads_trabalhados])), REMOVEFILTERS(execucao_comercial))
			VAR rp = CALCULATE(DIVIDE(SUM(execucao_comercial[propostas_enviadas]), SUM(execucao_comercial[reunioes_realizadas])), REMOVEFILTERS(execucao_comercial))
			VAR pf = CALCULATE(DIVIDE(SUM(execucao_comercial[fechamentos]), SUM(execucao_comercial[propostas_enviadas])), REMOVEFILTERS(execucao_comercial))
			RETURN SWITCH(SELECTEDVALUE(Param_Estagios[etapas_ate_fechar]), 1, pf, 2, rp * pf, 3, lr * rp * pf, 0)
		formatString: 0.0%
		displayFolder: 5. Impacto
		lineageTag: 19e0894b-be13-4be5-882a-dfcada89b646

	/// Leads abertos no estágio, com até 90 dias
	measure 'Leads Abertos até 90 Dias' =
			CALCULATE(COUNTROWS(leads_pipeline), leads_pipeline[status_lead] = SELECTEDVALUE(Param_Estagios[estagio]), leads_pipeline[tempo_ciclo_dias] <= 90)
		formatString: 0
		displayFolder: 5. Impacto
		lineageTag: 2ffcc996-2201-4792-9e7d-4f2403e3c85e

	/// Leads abertos há mais de 90 dias: nenhum Ganho da base fechou depois de 89 dias
	measure 'Leads Parados (> 90 dias)' =
			CALCULATE(COUNTROWS(leads_pipeline), leads_pipeline[status_lead] = SELECTEDVALUE(Param_Estagios[estagio]), leads_pipeline[tempo_ciclo_dias] > 90)
		formatString: 0
		displayFolder: 5. Impacto
		lineageTag: ab101931-f480-4681-870a-c07f6968b6fe

	/// Leads abertos até 90 dias × chance de fechar
	measure 'Ganhos Esperados' =
			[Leads Abertos até 90 Dias] * [Chance de Fechar]
		formatString: 0.0
		displayFolder: 5. Impacto
		lineageTag: 7842f637-5e43-414c-9633-04548525ba42

	/// Método 1: soma dos Ganhos esperados do pipeline aberto (próximo trimestre)
	measure 'Ganhos Previstos (Pipeline)' =
			SUMX(Param_Estagios, [Ganhos Esperados])
		formatString: 0.0
		displayFolder: 5. Impacto
		lineageTag: fe409cca-2cc7-4949-84e6-17ddcaa3c998

	/// mrr_inicial médio dos Ganhos
	measure 'Ticket Médio do Ganho' =
			CALCULATE(AVERAGE(leads_pipeline[mrr_inicial]), leads_pipeline[status_lead] = "Ganho")
		formatString: #,0
		displayFolder: 5. Impacto
		lineageTag: 4a219587-77a4-4b2f-b864-d7e189dc8671

	/// Ganhos previstos × ticket médio × (1 − churn), escala do CRM
	measure 'nMRR Previsto (Pipeline)' =
			[Ganhos Previstos (Pipeline)] * [Ticket Médio do Ganho] * (1 - DIVIDE(COUNTROWS(FILTER(ALL(clientes_ativos), clientes_ativos[status_cliente] = "Churned")), COUNTROWS(ALL(clientes_ativos))))
		formatString: #,0
		displayFolder: 5. Impacto
		lineageTag: ae464b06-31ff-4b35-9850-4c14630312d6

	/// Meses entre o primeiro e o último Ganho
	measure 'Meses de Histórico de Ganhos' =
			VAR d1 = CALCULATE(MIN(leads_pipeline[data_conversao]), leads_pipeline[status_lead] = "Ganho")
			VAR d2 = CALCULATE(MAX(leads_pipeline[data_conversao]), leads_pipeline[status_lead] = "Ganho")
			RETURN (YEAR(d2) - YEAR(d1)) * 12 + MONTH(d2) - MONTH(d1) + 1
		formatString: 0
		displayFolder: 5. Impacto
		lineageTag: e2c585f8-4fd6-4322-a7e2-c05f07c4d121

	/// Método 2: Ganhos do CRM por mês × 3
	measure 'Ganhos por Trimestre (Run-rate)' =
			DIVIDE(CALCULATE(COUNTROWS(leads_pipeline), leads_pipeline[status_lead] = "Ganho"), [Meses de Histórico de Ganhos]) * 3
		formatString: 0.0
		displayFolder: 5. Impacto
		lineageTag: 958c75e6-0670-48dd-bf22-52d26a7a8f75

	/// nMRR mensal dos Ganhos do CRM ÷ nMRR oficial da rede (tabela franquias)
	measure 'CRM ÷ nMRR Oficial' =
			DIVIDE(DIVIDE(CALCULATE(SUM(leads_pipeline[mrr_inicial]), leads_pipeline[status_lead] = "Ganho"), [Meses de Histórico de Ganhos]), SUM(franquias[realizado_nmrr_mes]))
		formatString: 0.0%
		displayFolder: 5. Impacto
		lineageTag: a65c8225-bc74-455c-93ae-7fedb0cdb466

	/// Nº de franquias abaixo da meta
	measure 'Franquias Abaixo da Meta' =
			COUNTROWS(FILTER(ALLNOBLANKROW(franquias), franquias[realizado_nmrr_mes] < franquias[meta_nmrr_mes]))
		formatString: 0
		displayFolder: 6. Desafio 3
		lineageTag: c95d8b01-dcdc-40c3-a4f1-7ab5271cdeb3

	/// Correlação de Pearson entre nº de ECs da franquia e atingimento (≈ 0,64)
	measure 'Correlação Nº de ECs × Atingimento' =
			VAR t = ALLNOBLANKROW(franquias)
			VAR mx = AVERAGEX(t, franquias[num_executivos])
			VAR my = AVERAGEX(t, franquias[atingimento])
			VAR cov = SUMX(t, (franquias[num_executivos] - mx) * (franquias[atingimento] - my))
			VAR sx = SQRT(SUMX(t, (franquias[num_executivos] - mx) ^ 2))
			VAR sy = SQRT(SUMX(t, (franquias[atingimento] - my) ^ 2))
			RETURN DIVIDE(cov, sx * sy)
		formatString: 0.00
		displayFolder: 6. Desafio 3
		lineageTag: 2dccf70c-e8dd-412c-a701-489e65ef0200

	/// Gap de meta no contexto (R$/mês)
	measure 'Gap (R$)' =
			SUM(franquias[gap])
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: 3f0ab71b-56f7-48d1-a36e-5829de55c1ed

	/// Atingimento quando abaixo de 100%
	measure 'Atingimento (abaixo da meta)' =
			VAR a = DIVIDE(SUM(franquias[realizado_nmrr_mes]), SUM(franquias[meta_nmrr_mes])) RETURN IF(a < 1, a)
		formatString: 0%
		displayFolder: 6. Desafio 3
		lineageTag: c920fbf7-54b2-44e0-acfa-fe3c9eaa663e

	/// Atingimento quando 100% ou mais
	measure 'Atingimento (na meta)' =
			VAR a = DIVIDE(SUM(franquias[realizado_nmrr_mes]), SUM(franquias[meta_nmrr_mes])) RETURN IF(a >= 1, a)
		formatString: 0%
		displayFolder: 6. Desafio 3
		lineageTag: d861b02c-b0b8-4590-a8ec-a9504e089abb

	/// Nº de ECs
	measure ECs =
			SUM(franquias[num_executivos])
		formatString: 0
		displayFolder: 6. Desafio 3
		lineageTag: ed40f77d-92db-451a-8612-97d1551f693d

	/// Endereçáveis do território da franquia
	measure 'Prospects no Território' =
			COUNTROWS(FILTER(ALL(mercado_contadores), mercado_contadores[franquia_responsavel] = SELECTEDVALUE(franquias[id_franquia]) && mercado_contadores[enderecavel] = "Sim"))
		formatString: 0
		displayFolder: 6. Desafio 3
		lineageTag: b01ec9a8-7ec3-424d-a222-fc6466c7bee6

	/// Endereçáveis do tier Alta no território
	measure 'Tier Alta no Território' =
			COUNTROWS(FILTER(ALL(mercado_contadores), mercado_contadores[franquia_responsavel] = SELECTEDVALUE(franquias[id_franquia]) && mercado_contadores[tier_prioridade] = "Alta"))
		formatString: 0
		displayFolder: 6. Desafio 3
		lineageTag: 96903765-43e5-4c82-96af-fd1811b7a4e3

	/// Endereçáveis do território ÷ ECs
	measure 'Prospects por EC' =
			DIVIDE([Prospects no Território], [ECs])
		formatString: 0.0
		displayFolder: 6. Desafio 3
		lineageTag: ed65308a-629d-4579-9298-de8fbac59fad

	/// nMRR oficial por EC
	measure 'Realizado por EC' =
			DIVIDE(SUM(franquias[realizado_nmrr_mes]), [ECs])
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: 9801ae73-d421-4210-9753-032746ad793c

	/// Meta de nMRR por EC
	measure 'Meta por EC' =
			DIVIDE(SUM(franquias[meta_nmrr_mes]), [ECs])
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: 457e1c22-612c-4d67-97ed-480be21904cb

	/// Meta de nMRR (R$/mês)
	measure 'Meta (R$)' =
			SUM(franquias[meta_nmrr_mes])
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: 37ca5c33-136f-48cf-88db-f565ca828061

	/// Parte do realizado que preenche a meta (barra de progresso)
	measure 'Realizado até a Meta' =
			IF(NOT ISBLANK([Meta (R$)]), MIN([Realizado (R$)], [Meta (R$)]))
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: 01a8e90f-5f25-468f-ad62-a639efdbaa00

	/// O que falta para bater a meta
	measure 'Falta para a Meta' =
			IF(NOT ISBLANK([Meta (R$)]), MAX([Meta (R$)] - [Realizado (R$)], 0))
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: 39093c71-9941-441d-8afc-393a0bb3be5a

	/// O que passou da meta
	measure 'Acima da Meta' =
			IF(NOT ISBLANK([Meta (R$)]), MAX([Realizado (R$)] - [Meta (R$)], 0))
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: ae4c485f-dd31-436f-816c-963df11bfa74

	/// Realizado ÷ meta no contexto (franquia ou região)
	measure Atingimento =
			DIVIDE([Realizado (R$)], [Meta (R$)])
		formatString: 0%
		displayFolder: 6. Desafio 3
		lineageTag: d28aabea-135c-4362-9041-db66de354ba7

	/// Realizado por EC ÷ realizado por EC da rede
	measure 'Realizado por EC vs Rede' =
			DIVIDE([Realizado por EC], DIVIDE(SUMX(ALLNOBLANKROW(franquias), franquias[realizado_nmrr_mes]), SUMX(ALLNOBLANKROW(franquias), franquias[num_executivos])))
		formatString: 0%
		displayFolder: 6. Desafio 3
		lineageTag: 24f9ab7a-f008-48d3-8a13-f9bde3d090da

	/// Média de fechamentos por EC por mês (execucao_comercial)
	measure 'Fechamentos por EC-mês' =
			AVERAGE(execucao_comercial[fechamentos])
		formatString: 0.00
		displayFolder: 6. Desafio 3
		lineageTag: 17fc6ec1-5b82-4523-ad40-c1af80d5f37e

	/// Média de leads trabalhados por EC por mês: a carga do EC (execucao_comercial)
	measure 'Leads por EC-mês' =
			AVERAGE(execucao_comercial[leads_trabalhados])
		formatString: 0.0
		displayFolder: 6. Desafio 3
		lineageTag: efcece5d-8daf-4940-98fc-726201859c9f

	/// % dos EC-mês sem nenhum fechamento (dispersão entre ECs)
	measure '% EC-mês sem Fechamento' =
			DIVIDE(COUNTROWS(FILTER(execucao_comercial, execucao_comercial[fechamentos] = 0)), COUNTROWS(execucao_comercial))
		formatString: 0%
		displayFolder: 6. Desafio 3
		lineageTag: f7074379-0816-43b6-aba0-1e98f0459168

	/// Realizado de nMRR (R$/mês)
	measure 'Realizado (R$)' =
			SUM(franquias[realizado_nmrr_mes])
		formatString: #,0
		displayFolder: 6. Desafio 3
		lineageTag: f49a8276-dcad-4176-baee-9abdd2974b06

	/// Fechamentos ÷ leads trabalhados (execucao_comercial, 2024)
	measure 'Conversão do Funil' =
			DIVIDE(SUM(execucao_comercial[fechamentos]), SUM(execucao_comercial[leads_trabalhados]))
		formatString: 0.0%
		displayFolder: 6. Desafio 3
		lineageTag: ef79e21b-fe02-4cfb-a093-a0919de817b9

	/// Endereçáveis por EC × conversão do funil da franquia
	measure 'Fechamentos Potenciais por EC' =
			[Prospects por EC] * [Conversão do Funil]
		formatString: 0.00
		displayFolder: 6. Desafio 3
		lineageTag: a7da26a6-dd51-4b29-853c-088f03376d6d

	/// 1 = franquia com mais fechamentos potenciais por EC (onde alocar o EC adicional)
	measure 'Ranking EC Adicional' =
			IF(HASONEVALUE(franquias[id_franquia]), RANKX(ALLNOBLANKROW(franquias), [Fechamentos Potenciais por EC]))
		formatString: 0
		displayFolder: 6. Desafio 3
		lineageTag: ab8cad54-5551-4359-baec-fde2b899bbae

	/// Franquia com mais fechamentos potenciais por EC
	measure 'Franquia Recomendada' =
			SUBSTITUTE(MAXX(TOPN(1, ALLNOBLANKROW(franquias), [Fechamentos Potenciais por EC]), franquias[nome_franquia]), "Franquia ", "")
		displayFolder: 6. Desafio 3
		lineageTag: 9bfeaa78-a4f6-450b-9bdb-aec7b8df3fcb

	column Coluna
		dataType: string
		isHidden
		lineageTag: fdddce45-2282-41aa-b78b-1a3534a30009
		summarizeBy: none
		sourceColumn: Coluna

		annotation SummarizationSetBy = User

	partition _Medidas = m
		mode: import
		source =
				let
				    Fonte = #table(type table [Coluna = text], {})
				in
				    Fonte

	annotation PBI_ResultType = Table
