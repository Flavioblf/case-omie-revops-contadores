                "textRuns": [
                  {
                    "value": "Uplift = % da capacidade × (lift do topo − 1) × fator de realização.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "fontWeight": "normal",
                      "color": "#001E27"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "O lift vem do target (converteu_omie), que diverge do fechamento real: por isso só uma fração (o fator) vira Ganho, e o número só se confirma com o piloto.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "fontWeight": "normal",
                      "color": "#001E27"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "O % é o número principal: as três fontes de nMRR da base estão em escalas diferentes.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#006B79"
